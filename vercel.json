{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/favicon.ico",
      "destination": "/paint-erp/frontend/icons/favicon.svg"
    },
    {
      "source": "/(.*)",
      "destination": "/paint-erp/frontend/$1"
    }
  ]
}